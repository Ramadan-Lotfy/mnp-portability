# --- MySQL ---
MYSQL_DATABASE=mnp
MYSQL_USER=mnp
MYSQL_PASSWORD=mnp
MYSQL_ROOT_PASSWORD=root

# --- Host ports ---
APP_PORT=8080
MYSQL_HOST_PORT=3307

# --- Business settings ---
# How long a request may stay PENDING before it is canceled, and how often the cleanup job runs.
PORTING_REQUEST_TIMEOUT=2m
PORTING_TIMEOUT_CHECK_INTERVAL=15s